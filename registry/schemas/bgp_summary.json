{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenConfigBgpSummary",
  "description": "Schema canônico unificado para resumo dos vizinhos e sessões BGP",
  "type": "object",
  "required": ["device", "peers"],
  "properties": {
    "device": {
      "type": "string",
      "description": "Hostname do dispositivo coletado"
    },
    "local_as": {
      "type": "integer",
      "description": "Sistema Autônomo local"
    },
    "router_id": {
      "type": "string",
      "description": "BGP Router ID configurado"
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["peer_ip", "remote_as", "state"],
        "properties": {
          "peer_ip": {
            "type": "string",
            "description": "IP do peer BGP"
          },
          "remote_as": {
            "type": "integer",
            "description": "Sistema Autônomo remoto do peer"
          },
          "peer_group": {
            "type": "string",
            "description": "Nome do grupo de peers se configurado"
          },
          "state": {
            "type": "string",
            "description": "Estado da sessão BGP (Established, Idle, Connect, Active, OpenSent, OpenConfirm)"
          },
          "uptime": {
            "type": "string",
            "description": "Tempo em que a sessão permaneceu no estado atual"
          },
          "prefixes_received": {
            "type": "integer",
            "description": "Quantidade de prefixos recebidos do peer"
          },
          "prefixes_accepted": {
            "type": "integer",
            "description": "Quantidade de prefixos aceitos"
          },
          "prefixes_advertised": {
            "type": "integer",
            "description": "Quantidade de prefixos anunciados ao peer"
          }
        }
      }
    }
  }
}
