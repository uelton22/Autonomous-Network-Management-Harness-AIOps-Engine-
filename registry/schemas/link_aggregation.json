{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenConfigLinkAggregation",
  "description": "Schema canônico unificado para telemetria de agregação de enlace (LAG / LACP / Eth-Trunk)",
  "type": "object",
  "required": ["device", "link_aggregations"],
  "properties": {
    "device": {
      "type": "string",
      "description": "Hostname ou IP do equipamento coletado"
    },
    "collected_at": {
      "type": "string",
      "description": "Timestamp ISO-8601 da coleta"
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_aggregations": { "type": "integer" },
        "active_aggregations": { "type": "integer" },
        "down_aggregations": { "type": "integer" },
        "total_lags": { "type": "integer" },
        "active_lags": { "type": "integer" },
        "down_lags": { "type": "integer" },
        "total_members": { "type": "integer" },
        "active_members": { "type": "integer" }
      }
    },
    "link_aggregations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lag_id", "name", "oper_status", "members"],
        "properties": {
          "lag_id": {
            "type": "string",
            "description": "Identificador único da agregação (ex: '1', '2')"
          },
          "name": {
            "type": "string",
            "description": "Nome da interface de agregação (ex: 'lag 1', 'Eth-Trunk 1')"
          },
          "oper_status": {
            "type": "string",
            "enum": ["UP", "DOWN", "UNKNOWN"],
            "description": "Status operacional da agregação"
          },
          "admin_status": {
            "type": "string",
            "enum": ["UP", "DOWN", "UNKNOWN"],
            "description": "Status administrativo"
          },
          "mode": {
            "type": "string",
            "description": "Modo de operação (STATIC, LACP_ACTIVE, LACP_PASSIVE)"
          },
          "description": {
            "type": ["string", "null"],
            "description": "Descrição cadastrada no grupo"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["interface", "oper_status", "aggregation_status"],
              "properties": {
                "interface": {
                  "type": "string",
                  "description": "Nome da interface física membro (ex: 'ten-gigabit-ethernet-1/1/5' ou 'GE1/0/1')"
                },
                "oper_status": {
                  "type": "string",
                  "enum": ["UP", "DOWN", "UNKNOWN"],
                  "description": "Status de enlace da porta"
                },
                "aggregation_status": {
                  "type": "string",
                  "description": "Status na agregação (active, inactive, standby)"
                },
                "lacp_status": {
                  "type": ["string", "null"],
                  "description": "Status da máquina de estados LACP"
                }
              }
            }
          }
        }
      }
    }
  }
}
