{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenConfigOSPFNeighbors",
  "description": "Schema canônico unificado para vizinhos e adjacências OSPF (openconfig-ospfv2)",
  "type": "object",
  "required": ["device", "neighbors"],
  "properties": {
    "device": {
      "type": "string",
      "description": "Hostname ou IP do equipamento local"
    },
    "collected_at": {
      "type": "string",
      "description": "Timestamp ISO da coleta"
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_neighbors": {
          "type": "integer",
          "description": "Total de vizinhos OSPF descobertos"
        },
        "full_neighbors": {
          "type": "integer",
          "description": "Total de vizinhos em estado Full"
        }
      }
    },
    "neighbors": {
      "type": "array",
      "description": "Lista de vizinhos OSPF",
      "items": {
        "type": "object",
        "required": ["router_id", "state", "local_interface"],
        "properties": {
          "router_id": {
            "type": "string",
            "description": "Router-ID do vizinho OSPF"
          },
          "state": {
            "type": "string",
            "description": "Estado da adjacência OSPF (Full, 2-Way, Init, Down, etc.)"
          },
          "local_interface": {
            "type": "string",
            "description": "Interface local onde o vizinho está conectado"
          },
          "area": {
            "type": "string",
            "description": "Área OSPF da adjacência (ex: 0.0.0.0)"
          },
          "address": {
            "type": "string",
            "description": "Endereço IP da interface do vizinho"
          },
          "priority": {
            "type": "integer",
            "description": "Prioridade OSPF do vizinho"
          },
          "dr_state": {
            "type": "string",
            "description": "Papel DR/BDR (DR, BDR, DROther, P2P, None)"
          },
          "dead_time": {
            "type": "string",
            "description": "Tempo restante do dead timer"
          },
          "uptime": {
            "type": "string",
            "description": "Tempo que a adjacência está ativa"
          }
        }
      }
    }
  }
}
