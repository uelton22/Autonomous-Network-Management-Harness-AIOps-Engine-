{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenConfigInterfaces",
  "description": "Schema canônico unificado para telemetria e estado de interfaces de rede",
  "type": "object",
  "required": ["device", "interfaces"],
  "properties": {
    "device": {
      "type": "string",
      "description": "Hostname do dispositivo coletado"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO-8601 da coleta"
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "admin_status", "oper_status"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da interface no padrão nativo do fabricante (ex: GE1/0/1, 100GE0/1/0)"
          },
          "canonical_name": {
            "type": "string",
            "description": "Nome canônico normalizado (ex: GigabitEthernet1/0/1, HundredGigE0/1/0)"
          },
          "type": {
            "type": "string",
            "description": "Tipo de interface (ethernetCsmacd, propVirtual, l2vlan, loopback)"
          },
          "description": {
            "type": "string",
            "description": "Descrição cadastrada na interface"
          },
          "admin_status": {
            "type": "string",
            "enum": ["UP", "DOWN", "TESTING", "UNKNOWN"],
            "description": "Status administrativo configurado"
          },
          "oper_status": {
            "type": "string",
            "enum": ["UP", "DOWN", "TESTING", "UNKNOWN", "DORMANT", "LOWER_LAYER_DOWN"],
            "description": "Status operacional físico/enlace"
          },
          "speed_bps": {
            "type": "integer",
            "description": "Velocidade negociada em bits por segundo (ex: 1000000000 para 1G)"
          },
          "mtu": {
            "type": "integer",
            "description": "MTU configurado na interface"
          },
          "mac_address": {
            "type": "string",
            "description": "Endereço MAC físico da porta"
          },
          "last_flapped": {
            "type": "string",
            "description": "Tempo desde a última mudança de estado (ex: '10 min ago' ou '2026-09-18 10:15:00')"
          },
          "ipv4": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["address", "prefix_length"],
              "properties": {
                "address": { "type": "string" },
                "prefix_length": { "type": "integer", "minimum": 0, "maximum": 32 }
              }
            }
          },
          "ipv6": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["address", "prefix_length"],
              "properties": {
                "address": { "type": "string" },
                "prefix_length": { "type": "integer", "minimum": 0, "maximum": 128 }
              }
            }
          },
          "statistics": {
            "type": "object",
            "properties": {
              "in_octets": { "type": "integer" },
              "out_octets": { "type": "integer" },
              "in_errors": { "type": "integer" },
              "out_errors": { "type": "integer" },
              "in_crc_errors": { "type": "integer" },
              "in_discards": { "type": "integer" },
              "out_discards": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
