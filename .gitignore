# =========================================================================
# Git Ignore - Autonomous Network Management Harness (AIOps Engine)
# =========================================================================

# --- Secrets & Credentials ---
.env
*.env
!.env.example
registry/credentials.yaml
!registry/credentials.example.yaml
storage/vault/


# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/

# --- IDEs & OS Metadata ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.antigravity/
.idea/
.vscode/
*.swp
*.swo
*~

# --- Telemetry, Captures & Sensitive Device Dumps ---
# Mantém a estrutura de diretórios, mas ignora outputs brutos de equipamentos reais
storage/raw/*
!storage/raw/.gitkeep

storage/normalized/*
!storage/normalized/.gitkeep

# --- Large Reference Files (Livros/PDFs pesados) ---
*.pdf

# --- Logs ---
*.log
