# =========================================================================
# Configurações de SSH para Conexão em Equipamentos Reais
# =========================================================================

# Usuário e Senha do terminal SSH
NETOPS_SSH_USER=admin
NETOPS_SSH_PASSWORD=admin

# Porta SSH (padrão: 22)
NETOPS_SSH_PORT=22

# Senha de modo enable/privilegiado (se aplicável)
# NETOPS_SSH_SECRET=sua_senha_enable

# Delay global para conexões via VPN/WAN mais lentas (1.0 = normal, 2.0 = WAN lenta)
NETOPS_SSH_DELAY=1.0

# Opcional: Chave Gemini para auto-cura avançada de templates TTP em firmwares novos
# GEMINI_API_KEY=sua_chave_gemini_aqui

# =========================================================================
# Configuração de LLM Local (Ollama, vLLM, LM Studio, etc.)
# =========================================================================
# URL base do servidor de LLM local compatível com OpenAI (padrão Ollama: http://localhost:11434/v1)
LLM_BASE_URL=http://localhost:11434/v1

# Modelo local a ser utilizado com suporte a Function Calling (ex: qwen2.5:14b, llama3.1:8b, llama3.3:70b)
LLM_MODEL=qwen2.5:14b

# Chave de API arbitrária exigida por clientes OpenAI (para Ollama pode ser qualquer valor)
LLM_API_KEY=ollama

# Temperatura para inferência de rede determinística (0.1 recomendada para Function Calling preciso)
LLM_TEMPERATURE=0.1
