# =========================================================================
# Configurações de SSH para Conexão em Equipamentos Reais
# =========================================================================

# Usuário e Senha do terminal SSH
NETOPS_SSH_USER=admin
NETOPS_SSH_PASSWORD=admin

# Porta SSH (padrão: 22)
NETOPS_SSH_PORT=22

# Senha de modo enable/privilegiado (se aplicável)
# NETOPS_SSH_SECRET=sua_senha_enable

# Delay global para conexões via VPN/WAN mais lentas (1.0 = normal, 2.0 = WAN lenta)
NETOPS_SSH_DELAY=1.0

# Opcional: Chave Gemini para auto-cura avançada de templates TTP em firmwares novos
# GEMINI_API_KEY=sua_chave_gemini_aqui
